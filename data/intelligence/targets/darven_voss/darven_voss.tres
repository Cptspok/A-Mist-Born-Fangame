[gd_resource type="Resource" script_class="CourtTargetDefinition" format=3]
[ext_resource type="Script" path="res://systems/intelligence/court_target_definition.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/2d/icons/intelligence/voss.svg" id="portrait"]
[ext_resource type="Script" path="res://systems/intelligence/court_intel_field_definition.gd" id="field_type"]
[ext_resource type="Resource" path="res://data/intelligence/targets/darven_voss/voss_field_profile.tres" id="profile"]
[ext_resource type="Resource" path="res://data/intelligence/targets/darven_voss/voss_field_location.tres" id="location"]
[ext_resource type="Resource" path="res://data/intelligence/targets/darven_voss/voss_field_tactics.tres" id="tactics"]
[resource]
script = ExtResource("script")
unique_id = &"darven_voss"
display_name = "Overseer Darven Voss"
portrait = ExtResource("portrait")
district_id = &"mini_city"
region_id = &"east_yard"
map_position = Vector2(0.5, 0.5)
associated_clue_ids = Array[StringName]([&"voss_identity", &"voss_location", &"voss_tactical"])
dossier_fields = Array[ExtResource("field_type")]([ExtResource("profile"), ExtResource("location"), ExtResource("tactics")])
map_reveal_field_id = &"location"
