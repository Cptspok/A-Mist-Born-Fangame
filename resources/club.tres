[gd_resource type="Resource" script_class="ItemDefinition" format=3]
[ext_resource type="Script" path="res://scripts/item_definition.gd" id="item"]
[ext_resource type="Script" path="res://scripts/melee_weapon_definition.gd" id="weapon"]
[ext_resource type="Script" path="res://scripts/equipment_profile.gd" id="profile"]
[ext_resource type="PackedScene" path="res://scenes/melee_weapon.tscn" id="runtime"]
[ext_resource type="PackedScene" path="res://scenes/club_visual.tscn" id="visual"]
[ext_resource type="Texture2D" path="res://resources/club.svg" id="icon"]
[ext_resource type="Resource" path="res://resources/weapons/club_moveset.tres" id="moveset"]
[ext_resource type="Resource" path="res://resources/weapons/club_material.tres" id="material"]
[sub_resource type="Resource" id="combat"]
script = ExtResource("weapon")
runtime_scene = ExtResource("runtime")
primary_action_label = "Attack"
secondary_action_label = "Block (hold)"
moveset = ExtResource("moveset")
can_block = true
damage = 38.0
block_strength = 16.0
blocked_damage_multiplier = 0.25
block_angle = 100.0
block_raise_time = 0.22
block_movement_multiplier = 0.3
[sub_resource type="Resource" id="equipment"]
script = ExtResource("profile")
allowed_slots = Array[int]([0, 1])
traits = Array[int]([0])
family = &"club"
[resource]
script = ExtResource("item")
item_id = "prototype_club"
display_name = "Wooden Club"
description = "Heavy overhead blow followed by a committed backhand. Hold secondary action to block."
characteristics = "1 x 3 | Wood | Non-metallic | High impact"
item_type = "Weapon"
grid_height = 3
inventory_sprite = ExtResource("icon")
world_visual = ExtResource("visual")
material = ExtResource("material")
combat_definition = SubResource("combat")
equipment_profile = SubResource("equipment")
