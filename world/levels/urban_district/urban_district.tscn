[sub_resource type="Resource" id="Resource_itk5j"]
script = ExtResource("64_7ht5u")
item_id = "intelligence/ashmarket_profile"
display_name = "Collector's account"
description = "Darven Voss rules Ashmarket from the northern manor. His collectors squeeze the southern households and levy every market cart."
item_type = "Intelligence"
inventory_sprite = ExtResource("63_4pxuh")
intelligence_clue = ExtResource("62_4grls")

[sub_resource type="Resource" id="Resource_nko5k"]
script = ExtResource("64_7ht5u")
item_id = "intelligence/ashmarket_location"
display_name = "Sealed delivery order"
description = "The Baron receives his officers in the ground-floor hall of the raised northern manor. The broad front stair and an eastern service stair both reach its terrace."
item_type = "Intelligence"
inventory_sprite = ExtResource("63_4pxuh")
intelligence_clue = ExtResource("67_4lgs1")

[sub_resource type="Resource" id="Resource_f3k6o"]
script = ExtResource("64_7ht5u")
item_id = "intelligence/ashmarket_tactics"
display_name = "Watchman's private notes"
description = "Voss fights at close range and stays near his hall. The rear opening leads onto the terrace; the eastern service stair offers another escape. The market galleries provide elevated approaches, but the manor guard has a clear view of the front stair."
item_type = "Intelligence"
inventory_sprite = ExtResource("63_4pxuh")
intelligence_clue = ExtResource("68_xgtyu")

